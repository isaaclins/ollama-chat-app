{
  "name": "ollama-chat-app",
  "version": "1.0.0",
  "description": "Local chat UI for Ollama llava-llama3",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npm install --omit=dev --silent && node server.js",
    "dev": "nodemon server.js",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "body-parser": "^1.20.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "prettier": "^3.2.5"
  },
  "keywords": [
    "ollama",
    "chat",
    "llm",
    "llava",
    "llama3",
    "webapp",
    "ai",
    "express"
  ],
  "repository": {
    "type": "git",
